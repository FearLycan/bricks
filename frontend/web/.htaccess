RewriteEngine on

# Hard block: SEO tools / scrapers (403 before PHP starts)
RewriteCond %{HTTP_USER_AGENT} (SemrushBot|AhrefsBot|SERankingBacklinksBot|Bytespider|PetalBot|Reflectionbot|TokenFoundryBot|MJ12bot|DotBot|DataForSeoBot|BLEXBot|ElevenlabsCrawler) [NC]
RewriteRule .* - [F,L]

# Bots do not get modals or per-page variants
RewriteCond %{REQUEST_URI} choice-modal [NC,OR]
RewriteCond %{QUERY_STRING} (^|&)per-page= [NC]
RewriteCond %{HTTP_USER_AGENT} (bot|crawler|spider) [NC]
RewriteRule .* - [F,L]

# English is the default language and has no URL prefix: /en/... -> /... for good
RewriteRule ^en(?:/(.*))?$ /$1 [R=301,L,QSA]

# Chrome Private Prefetch Proxy advice file — needs a specific Content-Type
<Files "traffic-advice">
    ForceType application/trafficadvice+json
</Files>

# if a directory or a file exists, use it directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# otherwise forward it to index.php
RewriteRule . index.php

# Disable directory listing
Options -Indexes

# Block WordPress probing
RedirectMatch 403 ^/wordpress(/.*)?$
RedirectMatch 403 ^/wp-.*$
RedirectMatch 403 ^/xmlrpc\.php$

# Block sensitive files: VCS, IDE, config
RedirectMatch 403 (?i)(^|/)\.(env|git|svn|hg|idea|vscode|ht)

# Block backups, dumps, sources, logs
RedirectMatch 403 (?i)\.(bak|backup|old|orig|save|swp|sql|tar|tgz|zip|log|ini|sh)$
RedirectMatch 403 (?i)(composer|package)\.(json|lock)$

# Block DB/admin tool probing
RedirectMatch 403 (?i)^/(phpmyadmin|pma|myadmin|dbadmin|adminer|mysql|sqladmin)