RewriteEngine on

# Hard block: SEO tools / scrapers (403 before PHP starts)
RewriteCond %{HTTP_USER_AGENT} (SemrushBot|AhrefsBot|SERankingBacklinksBot|Bytespider|PetalBot|Reflectionbot|TokenFoundryBot|MJ12bot|DotBot|DataForSeoBot|BLEXBot|ElevenlabsCrawler) [NC]
RewriteRule .* - [F,L]

# Bots do not get modals or per-page variants
RewriteCond %{REQUEST_URI} choice-modal [NC,OR]
RewriteCond %{QUERY_STRING} (^|&)per-page= [NC]
RewriteCond %{HTTP_USER_AGENT} (bot|crawler|spider) [NC]
RewriteRule .* - [F,L]

# Note: do not redirect /en/... here. The language switcher links to /en/...
# and the app (codemix/localeurls) must see it to remember the choice.

# Browser caching for static files. CSS/JS/fonts are versioned in the URL
# (assetManager appendTimestamp ?v=..., hashed /assets/ dirs, font ?hash), so a
# year is safe; unversioned images (logo, flags, browse tiles) get 30 days.
# HTML, XML (sitemaps) and JSON are not listed and stay uncached.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                 "access plus 1 year"
    ExpiresByType application/javascript   "access plus 1 year"
    ExpiresByType text/javascript          "access plus 1 year"
    ExpiresByType font/woff2               "access plus 1 year"
    ExpiresByType font/woff                "access plus 1 year"
    ExpiresByType application/font-woff2   "access plus 1 year"
    ExpiresByType application/font-woff    "access plus 1 year"
    ExpiresByType image/png                "access plus 30 days"
    ExpiresByType image/jpeg               "access plus 30 days"
    ExpiresByType image/webp               "access plus 30 days"
    ExpiresByType image/avif               "access plus 30 days"
    ExpiresByType image/gif                "access plus 30 days"
    ExpiresByType image/svg+xml            "access plus 30 days"
    ExpiresByType image/x-icon             "access plus 30 days"
    ExpiresByType image/vnd.microsoft.icon "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2?)$">
        Header merge Cache-Control "public"
    </FilesMatch>
</IfModule>

# Chrome Private Prefetch Proxy advice file — needs a specific Content-Type
<Files "traffic-advice">
    ForceType application/trafficadvice+json
</Files>

# if a directory or a file exists, use it directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# otherwise forward it to index.php
RewriteRule . index.php

# Disable directory listing
Options -Indexes

# Block WordPress probing
RedirectMatch 403 ^/wordpress(/.*)?$
RedirectMatch 403 ^/wp-.*$
RedirectMatch 403 ^/xmlrpc\.php$

# Block sensitive files: VCS, IDE, config
RedirectMatch 403 (?i)(^|/)\.(env|git|svn|hg|idea|vscode|ht)

# Block backups, dumps, sources, logs
RedirectMatch 403 (?i)\.(bak|backup|old|orig|save|swp|sql|tar|tgz|zip|log|ini|sh)$
RedirectMatch 403 (?i)(composer|package)\.(json|lock)$

# Block DB/admin tool probing
RedirectMatch 403 (?i)^/(phpmyadmin|pma|myadmin|dbadmin|adminer|mysql|sqladmin)